		(uuid "3699328a-8b55-437d-9a9c-e56f8dcfa2cf")
	)
	(text "Low threshold = 2V\n\nCurrent Amp minimum voltage = 3.68V\nIf signal shorted to GND or sensor disconnect,\nsignal pulled to GND so ERROR Trips"
		(exclude_from_sim no)
		(at 83.82 100.33 0)
		(effects
