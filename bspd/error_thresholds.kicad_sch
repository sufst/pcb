	)
	(text "CURRENT SENSOR DHAB LEM S/134 and CUSTOM AMP\nOutput voltage range after AMP:\n3.68V at 0A\n9.75V at saturation\n\nFor 450V Accu, need to trip at 11A for 5kW threshold\nTrip at ~10A for headroom\n11 Turns of wire in sensor - 0.9A test current\nMeasured trip voltage at 0.9A test current = 6.08V\n\nHigh threshold at 6V\nERROR Trips at 6.0V or over (e.g. sensor short to 12V)"
		(exclude_from_sim no)
		(at 163.322 43.18 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "a055ed1d-485c-4620-b3cb-6dcc56aae09d")
	)
	(text "This goes LOW if\nCurrent Sensor Disconnect"
		(exclude_from_sim no)
		(at 113.03 72.39 0)
		(effects
			(font
				(size 1 1)
				(thickness 0.125)
			)
		)
		(uuid "a332530a-d74c-42aa-bf38-883381152603")
	)
	(text "Adjustable with\ntrim pot if needed"
