	(text "Low threshold = 0.205V\n\nBPS minimum voltage output = 0.5V\nIf signal shorted to GND or sensor disconnect,\nsignal pulled to GND so ERROR Trips"
		(exclude_from_sim no)
		(at 83.82 187.96 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
