	)
	(text "The sensors will have resistors\nsoldered directly onto their\nterminals as shown, and a\npull-down resistor on the BSPD\nPCB. This will enable the\ndetection of fault conditions.\n\nShort to GND/open circuit:\n  0V measured\n\nShort to +12V:\n  12V measured\n\nNormal operation:\n  Minimum voltage ~= 0.1V due\n  to resistors, max voltage 5V"
		(exclude_from_sim no)
		(at -74.295 225.425 0)
		(effects
			(font
